# ==============================================================================
# TempoCare - Environment Variables
# ==============================================================================

# Supabase (Wajib jika menghubungkan ke instance Supabase live)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API (Pengiriman Token & Notifikasi Reservasi ke Pasien)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=TempoCare Clinic <notifications@tempocare.clinic>

# App Base URL (digunakan untuk link Reschedule / Cancel pada email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis (Opsional: Rate Limiting & Anti-Spam Bot)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

