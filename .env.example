# ==============================================================================
# TempoCare - Environment Variables
# ==============================================================================

# Supabase (Wajib jika menghubungkan ke instance Supabase live)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend API (Pilihan 1: Pengiriman Email via Resend)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=TempoCare Clinic <notifications@tempocare.clinic>

# SMTP / Gmail (Pilihan 2: Pengiriman Email via SMTP atau Gmail App Password)
# GMAIL_USER=faskes.tempocare@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=faskes.tempocare@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# App Base URL (digunakan untuk link Reschedule / Cancel pada email)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Upstash Redis (Opsional: Rate Limiting & Anti-Spam Bot)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

